# Project docs (local / not for public repo) — public README SVGs under docs/assets/ are tracked
docs/*
!docs/assets/
docs/assets/*
!docs/assets/*.svg

# Secrets and local env
.env
.env.*
!.env.example
!**/.env.example
env/

# Python bytecode and caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
ENV/
backend/venv/

# pytest / coverage / tox
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

backend/tests/*.bak

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.dmypy.json

# Backend (Django) — local DB, uploads, runtime
*.sqlite3
db.sqlite3
backend/db.sqlite3
backend/db.sqlite3-journal
staticfiles/
backend/staticfiles/
backend/local_settings.py
backend/**/*.log
celerybeat-schedule
celerybeat.pid

# Backend secrets (keep .env.example)
backend/.env
backend/.env.*
!backend/.env.example

# Python packaging
*.egg-info/
.eggs/
dist/
build/
pip-log.txt
pip-delete-this-directory.txt

# Tooling / IDE / AI (local only)
.impeccable
.gemini
.cursor
.grok
.claude
.agents/
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Frontend (Vite / npm)
frontend/**/node_modules/
frontend/**/dist/
frontend/**/dist-ssr/
frontend/**/.vite/
frontend/**/*.local
frontend/**/logs/
frontend/**/*.log
frontend/**/npm-debug.log*
frontend/**/yarn-debug.log*
frontend/**/yarn-error.log*
frontend/**/pnpm-debug.log*
frontend/**/.eslintcache
frontend/**/coverage/

backend/.test