# Copy to repo root `.env` and/or `backend/.env`. Root is loaded first; backend overrides.
SECRET_KEY=fake-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=False
TRUST_PROXY_SSL=False
ADMIN_ENABLED=True
ADMIN_URL=admin/

# Neon PostgreSQL (never commit real values)
DATABASE_URL_POOLED=postgresql://user:password@ep-fake-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-fake.region.aws.neon.tech/neondb?sslmode=require
# Pooled runtime URL (PgBouncer transaction mode); use direct URL for migrate/run_daily
DB_CONN_MAX_AGE=60
SLOW_REQUEST_MS=800
# Optional: separate DB for pytest (direct URL, no pooler); falls back to DATABASE_URL when unset
TEST_DATABASE_URL=postgresql://user:password@ep-fake-test.region.aws.neon.tech/test_neondb?sslmode=require

# Auth / email (non-secret; required for settings)
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
INVITE_DAYS=7
# Default local backend (no outbound mail). Production: set to core.email_backends.brevo.BrevoEmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Ongsho <noreply@example.com>
# Required when EMAIL_BACKEND=core.email_backends.brevo.BrevoEmailBackend (set on Render; never commit)
# BREVO_API_KEY=
# Optional HTTP timeout seconds for Brevo API calls (default 10)
# BREVO_API_TIMEOUT=10

# Transactional outbox — invite delivery secrets (versioned Fernet keys, JSON map). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INVITE_DELIVERY_ENCRYPTION_KEYS={"1": "<fernet-key-v1>", "2": "<fernet-key-v2>"}
# INVITE_DELIVERY_ENCRYPTION_ACTIVE_VERSION=2
# Worker processing lease and bounded retry cap (not guaranteed eventual delivery)
# OUTBOX_LEASE_SECONDS=900
# OUTBOUND_EMAIL_MAX_ATTEMPTS=8
# Outbox worker (cron every 1–2 min): use direct DATABASE_URL like migrate/run_daily (not DATABASE_URL_POOLED)
# python manage.py process_email_outbox --batch-size 50 --max-runtime 55
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax
