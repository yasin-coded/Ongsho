# Copy to repo root `.env` and/or `backend/.env`. Root is loaded first; backend overrides.
SECRET_KEY=fake-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL (never commit real values)
DATABASE_URL_POOLED=postgresql://user:password@ep-fake-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-fake.region.aws.neon.tech/neondb?sslmode=require

# Auth / email (non-secret; required for settings)
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Ongsho <noreply@example.com>
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax
